{
  "name": "proof",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "format": "prettier --write src vite.config.ts",
    "lint:core": "cargo clippy -p proof-core --all-targets -- -D warnings",
    "test": "vitest run",
    "test:core": "cargo test -p proof-core",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "check": "npm run typecheck && npm test && cargo test -p proof-core",
    "prepare:observer": "node scripts/prepare-observer.mjs",
    "prepare:observer:dev": "node scripts/prepare-observer.mjs --dev",
    "lint": "prettier --check src vite.config.ts",
    "release:build": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "monaco-editor": "0.56.0",
    "motion": "13.3.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hotkeys-hook": "5.3.3",
    "react-resizable-panels": "4.12.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.18.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
