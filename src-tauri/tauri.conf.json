{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proof",
  "version": "0.1.7",
  "identifier": "dev.proof.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:observer:dev && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:observer && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proof",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "shortDescription": "看清变化，认真审查。",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/proof-observer"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMTRDNUI0M0Y4NkM3RTYKUldUbXg0WS90TVVVY0twNHRrbFMxdm95NWpyeWJpZ3YxZDFTNElMZ0FyRUNjbGNqbUtSK1pQcTcK",
      "endpoints": [
        "https://github.com/10yihang/Proof/releases/latest/download/latest.json"
      ]
    }
  }
}
