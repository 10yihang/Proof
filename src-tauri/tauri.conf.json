{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proof",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.proof.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proof",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "shortDescription": "看清变化，认真审查。",
    "category": "DeveloperTool",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
