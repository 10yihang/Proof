{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Proof main window. No shell, filesystem or network plugin is exposed.",
  "windows": ["main", "diff-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
